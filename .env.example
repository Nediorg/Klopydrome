# Copy to .env and fill in. .env is gitignored (contains secrets).
# The scripts load it automatically from the repo root.

# Personal access token with permission to create releases.
# Required for ./scripts/publish-release.sh and ./scripts/release.sh
PUBLISH_TOKEN=

# Optional overrides. By default the host, API base and repo are guessed from
# the git remote (e.g. https://git.example.tld/api/v1, owner/repo).
# PUBLISH_API_URL=https://git.example.tld/api/v1
# PUBLISH_REPO=owner/repo

# Optional: bundle/product name and app display name.
# APP_NAME=Klopydrome
